# Paritok hosted GPU (required — must be accepted by dashboard, not 401)
# https://paritok.com → dashboard → API keys
PARITOK_API_KEY=pk_live_...

# --- Free upstream LLM (pick ONE) ---
# Groq free tier (recommended for Wave 0):
#   1. https://console.groq.com/keys  → create key (no card)
#   2. paste below
OPENAI_API_KEY=gsk_...
RAGMOD_OPENAI_URL=https://api.groq.com/openai
RAGMOD_MODEL=llama-3.1-8b-instant

